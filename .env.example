# Copy to /apps/pollards/.env on the VPS (chmod 600). `next start` and
# `npm run db:migrate` both read it. Never commit the real file.

# ---- Database (local PostgreSQL on the VPS, loopback only) ----
DATABASE_URL=postgresql://pollards:CHANGE_ME@127.0.0.1:5432/pollards
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Security ----
# Staff dashboard passcode
ADMIN_PASSKEY=
# Signs session cookies and hashes sign-in codes. Generate: openssl rand -base64 48
SESSION_SECRET=

# ---- Email (sign-in codes + appointment updates) ----
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=Pollards <bookings@pollards.info>

# ---- Optional SMS via Twilio (leave blank to notify by email only) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Files ----
# ID document uploads. Keep outside the app folder so redeploys can't touch them.
UPLOAD_DIR=/var/lib/pollards/uploads

# ---- Public ----
NEXT_PUBLIC_SITE_URL=https://pollards.info
# Google Analytics, loaded only after cookie consent. Previous ID: G-TB132L221S
NEXT_PUBLIC_GA_ID=G-TB132L221S

# ---- Local testing only ----
# Write outgoing email/SMS as JSON files here instead of sending them.
# MAIL_OUTBOX_DIR=./tmp/outbox
