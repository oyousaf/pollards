# Appwrite (server-only — never prefix these with NEXT_PUBLIC_)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_PATIENT_TABLE_ID=
APPWRITE_APPOINTMENT_TABLE_ID=
APPWRITE_BUCKET_ID=

# Admin access — exactly 4 digits. Rotate it: the old NEXT_PUBLIC_ADMIN_PASSKEY was shipped to every browser.
ADMIN_PASSKEY=
# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public
NEXT_PUBLIC_SITE_URL=https://pollards.info
# Google Analytics (loaded only after cookie consent). Previous ID: G-TB132L221S
NEXT_PUBLIC_GA_ID=
